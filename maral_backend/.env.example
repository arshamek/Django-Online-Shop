# MaralOnlineShop backend - environment template.
# Copy to `.env` (git-ignored) and fill in. NEVER commit a real .env.
# Every variable is documented in docs/setup/ENVIRONMENT.md.

# ---- Django ---------------------------------------------------------------
# Lets settings read this file when running outside Docker (compose loads it itself).
DJANGO_READ_DOT_ENV_FILE=true
# Production: REQUIRED, >= 50 random chars:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Development falls back to an insecure built-in key when empty.
SECRET_KEY=
# Development default true. Production refuses to start with DEBUG=true.
DEBUG=true
# Comma-separated hostnames. Production: REQUIRED, explicit, no "*".
ALLOWED_HOSTS=localhost,127.0.0.1
# Obscure the admin URL in production (must end with a slash).
DJANGO_ADMIN_URL=admin/
LANGUAGE_CODE=fa
APP_VERSION=0.1.0
GIT_COMMIT=unknown

# ---- Accounts / browser auth ---------------------------------------------------------
# Base URL of the React app; used in email links (password reset, email verification).
FRONTEND_BASE_URL=http://localhost:5173
# Cookie scope. Same-site frontend/API: keep Lax. Different registrable domains: None (HTTPS only).
COOKIE_SAMESITE=Lax
# SESSION_COOKIE_DOMAIN=.example.com
# CSRF_COOKIE_DOMAIN=.example.com
# Number of reverse proxies in front of Django (0 = ignore X-Forwarded-For). Wrong values make
# rate limiting spoofable or throttle everyone behind the proxy as one client.
TRUSTED_PROXY_COUNT=0
DEFAULT_PHONE_REGION=IR
# Dotted path of the SMS backend. Production default is "disabled": phone verification returns 503
# until a real provider backend is configured. Development uses the console backend.
# SMS_BACKEND=apps.accounts.delivery.DisabledSMSBackend
THROTTLE_RATE_AUTH_LOGIN=60/hour
THROTTLE_RATE_AUTH_REGISTER=10/hour
THROTTLE_RATE_AUTH_PASSWORD_RESET=10/hour
THROTTLE_RATE_AUTH_VERIFY=20/hour

# ---- Browser access (frontend origin(s), comma-separated, no trailing slash) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---- Database: Microsoft SQL Server (mssql-django + ODBC Driver 18) --------
DB_NAME=maral
DB_USER=sa
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
# "yes" only for local containers with self-signed certificates. Keep "no" with a real certificate.
DB_TRUST_SERVER_CERTIFICATE=yes
DB_CONN_MAX_AGE=60
# Tests default to SQL Server. "sqlite" = smoke mode only (validates nothing SQL-Server-specific).
TEST_DATABASE=sqlserver

# ---- Redis / Celery -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Optional overrides (default: REDIS_URL). Docker compose uses DB 1 for the broker.
CELERY_BROKER_URL=redis://localhost:6379/1
# CACHE_REDIS_URL=redis://localhost:6379/0
BEAT_HEARTBEAT_SECONDS=300

# ---- API behaviour ------------------------------------------------------------
API_DOCS_ENABLED=true
THROTTLE_RATE_ANON=120/min
THROTTLE_RATE_USER=300/min
THROTTLE_RATE_CATALOG_SEARCH=60/min

# ---- Production transport security (defaults shown) -----------------------------
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false

# ---- Logging ------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Email --------------------------------------------------------------------------
# Development default prints emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MaralOnlineShop <no-reply@example.com>

# ---- RESERVED for later phases (read by settings, consumed by no code yet) ---------
# External APIs: only official APIs / licensed feeds. Leave empty until access is authorised.
TRENDYOL_API_KEY=
NAMSHI_API_KEY=

# ---- Product import engine (Phase 5) ------------------------------------------------
# fixture = bundled synthetic data, no network. live = authorised source only (see docs/imports).
IMPORTS_PROVIDER_MODE=fixture
IMPORTS_ALLOW_FIXTURE_PUBLISH=false
IMPORTS_AUTO_PUBLISH=false
# Trendyol Partner (seller) API credentials. Only if Maral holds them or is authorised by a seller.
TRENDYOL_SELLER_ID=
TRENDYOL_API_SECRET=
TRENDYOL_INTEGRATOR_NAME=
TRENDYOL_STAGE=true
# Path of a licensed Namshi catalogue feed file, once Namshi grants one.
NAMSHI_FEED_PATH=
CURRENCY_RATE_PROVIDER=manual
CURRENCY_RATE_API_KEY=
SMS_API_KEY=

# AI + translation providers ("fake" = mocked adapter).
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=
TRANSLATION_PROVIDER=fake
TRANSLATION_API_KEY=

# Payments ("fake" = mocked gateway).
PAYMENT_GATEWAY=fake
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Object storage (S3-compatible).
STORAGE_BACKEND=filesystem
S3_ENDPOINT_URL=
S3_CUSTOM_DOMAIN=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=

# ---- docker-compose.yml only ----------------------------------------------------------
# SQL Server "sa" password: >= 8 chars with upper, lower, digit and symbol (SQL Server policy).
MSSQL_SA_PASSWORD=
# SQLSERVER_PORT=1433
# REDIS_PORT=6379
# CELERY_CONCURRENCY=2
# WEB_CONCURRENCY=3

# --- Catalogue (Phase 4) ---
CATALOG_IMAGE_MAX_BYTES=5242880
CATALOG_SHOW_MACHINE_TRANSLATIONS=true
